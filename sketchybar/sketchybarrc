#!/opt/homebrew/opt/lua@5.4/bin/lua

local HOME = os.getenv("HOME") or ""
local CONFIG_DIR = HOME .. "/.config/sketchybar/"

-- Allow require("helpers"), require("init"), etc. regardless of cwd
package.path = CONFIG_DIR .. "?.lua;" .. CONFIG_DIR .. "?/init.lua;" .. package.path

-- SbarLua module
package.cpath = package.cpath .. ";" .. HOME .. "/.local/share/sketchybar_lua/?.so"

-- Luarocks paths (Lua 5.4) for aerospace.lua dependencies: posix, cjson
package.path = package.path
    .. ";/opt/homebrew/share/lua/5.4/?.lua;/opt/homebrew/share/lua/5.4/?/init.lua"
    .. ";/opt/homebrew/lib/lua/5.4/?.lua;/opt/homebrew/lib/lua/5.4/?/init.lua"
    .. ";" .. HOME .. "/.luarocks/share/lua/5.4/?.lua"
    .. ";" .. HOME .. "/.luarocks/share/lua/5.4/?/init.lua"
package.cpath = package.cpath
    .. ";/opt/homebrew/lib/lua/5.4/?.so"
    .. ";" .. HOME .. "/.luarocks/lib/lua/5.4/?.so"

require("helpers")
require("init")
